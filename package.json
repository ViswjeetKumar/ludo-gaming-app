{
  "name": "ludo-gaming-app",
  "version": "0.0.0",
  "private": true,
  "description": "Secure, server-authoritative multiplayer Ludo.",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "dev:web": "npm run dev --workspace @ludo/web",
    "build:web": "npm run build --workspace @ludo/web"
  },
  "devDependencies": {"@types/react":"19.3.0","@types/react-dom":"19.3.0","@vitejs/plugin-react":"6.1.2","typescript":"5.9.3","vite":"8.3.5"}
}
